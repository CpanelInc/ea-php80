Bump the reported PHP version to 8.0.31 to mark the security backports;
no upstream 8.0.31 release exists.

--- a/configure.ac
+++ b/configure.ac
@@ -17,7 +17,7 @@
 dnl ----------------------------------------------------------------------------
 
 AC_PREREQ([2.68])
-AC_INIT([PHP],[8.0.30],[https://bugs.php.net],[php],[https://www.php.net])
+AC_INIT([PHP],[8.0.31],[https://bugs.php.net],[php],[https://www.php.net])
 AC_CONFIG_SRCDIR([main/php_version.h])
 AC_CONFIG_AUX_DIR([build])
 AC_PRESERVE_HELP_ORDER
--- a/main/php_version.h
+++ b/main/php_version.h
@@ -2,7 +2,7 @@
 /* edit configure.ac to change version number */
 #define PHP_MAJOR_VERSION 8
 #define PHP_MINOR_VERSION 0
-#define PHP_RELEASE_VERSION 30
+#define PHP_RELEASE_VERSION 31
 #define PHP_EXTRA_VERSION ""
-#define PHP_VERSION "8.0.30"
-#define PHP_VERSION_ID 80030
+#define PHP_VERSION "8.0.31"
+#define PHP_VERSION_ID 80031
